# Cursor API key (optional reviewer). You can also pass --api-key to the agent CLI.
CURSOR_API_KEY=
# Fine-grained GitHub PAT for tomiwu/image-token-saver.
# Required repository permissions: Contents, Issues, Pull requests, Workflows, Administration (read/write).
# Store the real token only in .sandcastle/.env (gitignored). Never commit it.
GH_TOKEN=
# Claude Code (implementer): prefer the subscription token from `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional. Official count_tokens uses an API key. Do not put a key here in the example value.
ANTHROPIC_API_KEY=
