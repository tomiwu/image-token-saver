{
  "name": "image-token-saver",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.3"
  },
  "scripts": {
    "sandcastle": "npx tsx .sandcastle/main.mts",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "tools/lint/node_modules/.bin/eslint --config tools/lint/eslint.config.js .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "postinstall": "npm ci --prefix tools/lint"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "@types/node": "24.19.2",
    "prettier": "3.10.1",
    "tsx": "^4.21.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "sharp": "0.35.5"
  }
}
